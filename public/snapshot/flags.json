{"bits":[{"bit":0,"name":"TRANSIENT","meaning":"transient in the ramp, such as a cosmic-ray hit","treatment":"informational"},{"bit":1,"name":"OVERFLOW","meaning":"nearing saturation","treatment":"kept, brightness indicative only"},{"bit":2,"name":"SUR_ERROR","meaning":"possible error in the ramp fit, common on bright sources","treatment":"kept, brightness indicative only"},{"bit":4,"name":"PHANTOM","meaning":null,"treatment":"informational"},{"bit":5,"name":"REFERENCE","meaning":null,"treatment":"informational"},{"bit":6,"name":"NONFUNC","meaning":"dead pixel","treatment":"pixel excluded"},{"bit":7,"name":"DICHROIC","meaning":"unusable pixel in the dichroic region","treatment":"pixel excluded"},{"bit":9,"name":"MISSING_DATA","meaning":"no data","treatment":"pixel excluded"},{"bit":10,"name":"HOT","meaning":"noisy pixel","treatment":"pixel excluded"},{"bit":11,"name":"COLD","meaning":"dead pixel","treatment":"pixel excluded"},{"bit":12,"name":"FULLSAMPLE","meaning":"full ramp history available","treatment":"informational"},{"bit":14,"name":"PHANMISS","meaning":"phantom correction missing","treatment":"pixel excluded"},{"bit":15,"name":"NONLINEAR","meaning":"beyond the nonlinearity correction","treatment":"kept, brightness indicative only"},{"bit":17,"name":"PERSIST","meaning":"persistent charge from an earlier exposure","treatment":"kept, brightness indicative only"},{"bit":19,"name":"OUTLIER","meaning":"flagged as an outlier","treatment":"pixel excluded"},{"bit":20,"name":"CROSSTALK","meaning":"detector crosstalk","treatment":"kept, reported as possible contamination"},{"bit":21,"name":"SOURCE","meaning":"pixel belongs to a known source","treatment":"informational"},{"bit":22,"name":"GHOST","meaning":"optical ghost of a bright source","treatment":"kept, reported as possible contamination"},{"bit":23,"name":"GHOST_FPA","meaning":"ghost from elsewhere on the focal plane","treatment":"kept, reported as possible contamination"},{"bit":24,"name":"GHOST_EXT","meaning":"ghost from a source outside the field","treatment":"kept, reported as possible contamination"},{"bit":25,"name":"STREAK","meaning":"satellite or debris streak","treatment":"pixel excluded"},{"bit":26,"name":"BLOOM","meaning":"blooming around a saturated source","treatment":"kept, brightness indicative only"},{"bit":27,"name":"SNOWBALL","meaning":"cosmic-ray snowball","treatment":"pixel excluded"},{"bit":28,"name":"HALO","meaning":"transient halo","treatment":"kept, reported as possible contamination"},{"bit":29,"name":"SATELLITE_HALO","meaning":"halo from a satellite","treatment":"kept, reported as possible contamination"}],"transient_rule":"TRANSIENT excludes a pixel only where SOURCE is not also set, so cosmic rays are removed while bright stars are kept.","source":"Bit names come from each file's MSKN header cards; QR2 files carry none, so the standard table is used."}